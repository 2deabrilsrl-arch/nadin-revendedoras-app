generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  password         String
  name             String
  dni              String           @unique
  telefono         String
  handle           String           @unique
  margen           Float            @default(60)
  cbu              String?
  alias            String?
  cvu              String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  profilePhoto     String?
  bio              String?
  instagram        String?
  facebook         String?
  tiktok           String?
  whatsappBusiness String?
  linkedin         String?
  twitter          String?
  youtube          String?
  website          String?
  rol              String           @default("revendedora")
  // Datos fiscales para el cliente en Dragonfish (CF = Consumidor Final con DNI)
  situacionFiscal  String           @default("CF")
  cuit             String?
  razonSocial      String?
  // Código de cliente en Dragonfish si ya existe con un código viejo (lo carga Nadin)
  codigoDragonfish String?
  // 🔑 NUEVO: Campos para recuperación de contraseña
  resetToken       String?
  resetTokenExpiry DateTime?
  consolidaciones  Consolidacion[]
  notificaciones   Notificacion[]
  pedidos          Pedido[]
  points           Point[]
  rankings         Ranking[]
  badges           UserBadge[]
  brandSales       UserBrandSales[]
  level            UserLevel?
  tienda           Tienda?
}

model Pedido {
  id                  String             @id @default(cuid())
  userId              String
  cliente             String
  telefono            String?
  nota                String?
  estado              String             @default("pendiente")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  
  // 🔥 NUEVO: Relación con consolidación
  consolidacionId     String?
  
  // Estados del pedido (logística)
  orderStatus         String             @default("pending")
  
  // Estados de pago
  paidToNadin         Boolean            @default(false)
  paidByClient        Boolean            @default(false)
  
  // ✅ FECHAS EXISTENTES - MANTENIDAS
  deliveredAt         DateTime?
  receivedNadinAt     DateTime?
  sentToClientAt      DateTime?
  
  // ✅ FECHAS NUEVAS - AGREGADAS
  sentToNadinAt       DateTime?
  armadoIniciadoAt    DateTime?
  armadoCompletoAt    DateTime?
  pagadoAt            DateTime?
  enviadoAt           DateTime?
  entregadoAt         DateTime?
  paidToNadinAt       DateTime?
  paidByClientAt      DateTime?
  
  // Datos de armado
  armadoEn            DateTime?
  armadoPor           String?
  productosArmados    Int?
  productosFaltantes  Int?
  productosOriginales Int?
  
  lineas              Linea[]
  user                User               @relation(fields: [userId], references: [id])
  consolidacion       Consolidacion?     @relation(fields: [consolidacionId], references: [id])
  PedidoAccessToken   PedidoAccessToken?
  PedidoMensaje       PedidoMensaje[]

  @@index([userId])
  @@index([estado])
  @@index([orderStatus])
  @@index([createdAt])
  @@index([consolidacionId])
}

model Linea {
  id               String  @id @default(cuid())
  pedidoId         String
  productId        String
  variantId        String
  sku              String?
  brand            String?
  name             String
  talle            String?
  color            String?
  qty              Int
  mayorista        Float
  venta            Float
  cantidadOriginal Int?
  cliente          String?
  nota             String?
  telefono         String?
  pedido           Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
  @@index([productId])
}

model Consolidacion {
  id                   String                       @id @default(cuid())
  userId               String
  pedidoIds            String
  formaPago            String
  tipoEnvio            String
  transporteNombre     String?
  totalMayorista       Float
  totalVenta           Float
  ganancia             Float
  descuentoTotal       Float                        @default(0)
  costoReal            Float?
  gananciaNeta         Float?
  csvPath              String?
  enviadoAt            DateTime                     @default(now())
  armadoIniciadoAt     DateTime?
  armadoEn             DateTime?
  completadoEn         DateTime?
  estado               String                       @default("enviado")
  pagadoEn             DateTime?
  cerrado              Boolean                      @default(false)
  // Dragonfish: remito generado por el puente de la Servidora
  dfEstado             String?                      // null (no aplica) | pendiente | procesando | generado | error
  dfComprobante        String?                      // ej: "R 0001-00012345"
  dfError              String?
  dfIntentos           Int                          @default(0)
  dfActualizadoAt      DateTime?
  dfFaltantes          Json?                        // lo que no había en stock al generar el remito
  
  // 🔥 NUEVO: Relación inversa con pedidos
  pedidos              Pedido[]
  
  // 🆕 NUEVO: Relación con documentos adjuntos (remitos PDF)
  documentos           ConsolidacionDocumento[]
  
  user                 User                         @relation(fields: [userId], references: [id])
  accessTokens         ConsolidacionAccessToken?
  ConsolidacionMensaje ConsolidacionMensaje[]

  @@index([userId])
  @@index([enviadoAt])
  @@index([estado])
  @@index([cerrado])
  @@index([dfEstado])
}

model CatalogoCache {
  id              String   @id @default(cuid())
  productId       String   @unique
  data            String
  brand           String?
  category        String?
  sex             String?
  salesCount      Int      @default(0)
  bestSellerRank  Int?                    // 🆕 NUEVO: Posición en ranking de TN (1 = más vendido)
  slug            String?                 // Tiendas: handle del producto en TN (URL amigable)
  descripcion     String?                 // Tiendas: descripción HTML de TN (SEO)
  updatedAt       DateTime @default(now())

  @@index([brand])
  @@index([sex])
  @@index([salesCount])
  @@index([bestSellerRank])              // 🆕 NUEVO: Índice para ordenar rápido
  @@index([updatedAt])
}

model Badge {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  icon        String
  category    String
  condition   String
  points      Int         @default(0)
  rarity      String      @default("common")
  createdAt   DateTime    @default(now())
  users       UserBadge[]

  @@index([category])
  @@index([rarity])
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())
  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([unlockedAt])
}

model UserLevel {
  id           String   @id @default(cuid())
  userId       String   @unique
  currentLevel String   @default("bronce")
  currentXP    Int      @default(0)
  totalSales   Int      @default(0)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([currentLevel])
  @@index([totalSales])
}

model Point {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  reason      String
  description String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([reason])
}

model Ranking {
  id        String   @id @default(cuid())
  userId    String
  period    String
  category  String
  position  Int
  value     Float
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, category])
  @@index([period])
  @@index([category])
  @@index([position])
}

model BrandAmbassador {
  id        String   @id @default(cuid())
  brandSlug String   @unique
  brandName String
  logoUrl   String?
  logoEmoji String   @default("👑")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([isActive])
  @@index([brandSlug])
}

model UserBrandSales {
  id         String   @id @default(cuid())
  userId     String
  brandSlug  String
  salesCount Int      @default(0)
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, brandSlug])
  @@index([userId])
  @@index([brandSlug])
  @@index([salesCount])
}

model Notificacion {
  id        String   @id @default(cuid())
  userId    String
  tipo      String
  titulo    String
  mensaje   String
  leida     Boolean  @default(false)
  metadata  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, leida])
  @@index([createdAt])
}

model ConsolidacionAccessToken {
  id              String        @id @default(cuid())
  consolidacionId String        @unique
  token           String        @unique
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime      @default(now())
  consolidacion   Consolidacion @relation(fields: [consolidacionId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
}

model ConsolidacionMensaje {
  id              String        @id @default(cuid())
  consolidacionId String
  autorId         String?
  autorNombre     String
  autorTipo       String
  mensaje         String
  leido           Boolean       @default(false)
  createdAt       DateTime      @default(now())
  Consolidacion   Consolidacion @relation(fields: [consolidacionId], references: [id], onDelete: Cascade)

  @@index([consolidacionId])
  @@index([createdAt])
  @@index([leido])
}

model PedidoAccessToken {
  id        String    @id @default(cuid())
  pedidoId  String    @unique
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  Pedido    Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([token])
}

model PedidoMensaje {
  id          String   @id @default(cuid())
  pedidoId    String
  autorId     String
  autorNombre String
  autorTipo   String
  mensaje     String
  leido       Boolean  @default(false)
  createdAt   DateTime @default(now())
  Pedido      Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([leido])
  @@index([pedidoId])
}

// 🆕 NUEVO: Tabla para documentos adjuntos (remitos PDF)
model ConsolidacionDocumento {
  id              String        @id @default(cuid())
  consolidacionId String
  consolidacion   Consolidacion @relation(fields: [consolidacionId], references: [id], onDelete: Cascade)
  
  filename        String        // Nombre único en storage: remito_cons123_1702380000.pdf
  originalName    String        // Nombre original del archivo subido
  storageUrl      String        // Path en Supabase Storage
  publicUrl       String        // URL pública para descargar
  fileSize        Int           // Tamaño en bytes
  mimeType        String        // application/pdf
  
  uploadedBy      String        // userId de quien subió (Nadin)
  uploadedAt      DateTime      @default(now())
  
  @@index([consolidacionId])
  @@map("ConsolidacionDocumento")
}

// =====================================================================
// TIENDAS NADIN — tienda web propia de cada revendedora
// Todo aditivo: no modifica tablas existentes salvo 2 columnas opcionales
// en CatalogoCache (slug, descripcion).
// =====================================================================

model Tienda {
  id                String   @id @default(cuid())
  userId            String   @unique
  slug              String   @unique // subdominio: {slug}.<TIENDAS_ROOT_DOMAIN>
  dominioPropio     String?  @unique // ej: www.lenceriamaria.com.ar
  dominioPendiente  String?  @unique // dominio cargado que todavía no apunta bien (se activa solo)
  activa            Boolean  @default(false)
  nombre            String
  eslogan           String?
  descripcion       String?  // texto "Sobre nosotros" (SEO)
  logoUrl           String?
  bannerUrl         String?
  colorPrimario     String   @default("#e11d74")
  colorSecundario   String   @default("#111827")
  fuente            String   @default("moderna") // moderna | elegante | clasica
  ciudad            String?  // SEO local
  provincia         String?
  whatsapp          String?
  instagram         String?
  facebook          String?
  tiktok            String?
  email             String?
  margen            Float?   // si es null usa User.margen
  seoTitulo         String?
  seoDescripcion    String?
  mostrarNadin      Boolean  @default(false) // pie "Productos de Nadin Lencería" (opcional)
  envioAutoNadin    Boolean  @default(false) // al quedar paga, enviar a Nadin sin preguntar
  nadinFormaPago    String?  // última forma de pago a Nadin usada (efectivo, transferencia, mercadopago, tarjeta)
  nadinTipoEnvio    String?  // retiro | envio
  nadinTransporte   String?  // nombre del transporte si es envío
  diseno            Json?    // portada: anuncio, slides, beneficios, estilo
  disenoBorrador    Json?    // cambios sin publicar del editor: { diseno, colorPrimario, colorSecundario, fuente }
  metaPixelId       String?
  ga4Id             String?
  googleVerificacion String? // código de verificación de Google (Merchant Center / Search Console)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  metodosPago       TiendaMetodoPago[]
  envios            TiendaEnvio[]
  cupones           TiendaCupon[]
  productos         TiendaProducto[]
  ordenes           OrdenTienda[]
  productosPropios TiendaProductoPropio[]
  paginas          TiendaPagina[]
  contactos        TiendaContacto[]
  promociones      TiendaPromocion[]
  carritos         TiendaCarrito[]
  stockExtra       TiendaStockExtra[]
}

model TiendaMetodoPago {
  id            String   @id @default(cuid())
  tiendaId      String
  tipo          String   // transferencia | mercadopago | link | efectivo
  nombre        String   // texto que ve la clienta
  activo        Boolean  @default(true)
  descuentoPct  Float    @default(0) // ej. 10% off pagando por transferencia
  instrucciones String?
  config        Json?    // transferencia: {alias,cbu,titular,banco} | link: {url} | mercadopago: {accessToken,publicKey,userId,refreshToken,expiresAt}
  orden         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tienda        Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@index([tiendaId])
}

model TiendaEnvio {
  id           String   @id @default(cuid())
  tiendaId     String
  tipo         String   // retiro | domicilio | correo
  nombre       String
  descripcion  String?
  precio       Float    @default(0)
  gratisDesde  Float?   // envío gratis desde este subtotal
  pideDireccion Boolean @default(true)
  activo       Boolean  @default(true)
  orden        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tienda       Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@index([tiendaId])
}

model TiendaCupon {
  id         String    @id @default(cuid())
  tiendaId   String
  codigo     String    // guardado en MAYÚSCULAS
  tipo       String    // porcentaje | monto | envio_gratis
  valor      Float     @default(0)
  minimo     Float?    // compra mínima
  usosMax    Int?
  usos       Int       @default(0)
  venceAt    DateTime?
  activo     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  tienda     Tienda    @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@unique([tiendaId, codigo])
}

model TiendaProducto {
  id            String   @id @default(cuid())
  tiendaId      String
  productId     String
  oculto        Boolean  @default(false)
  destacado     Boolean  @default(false)
  precioPropio  Float?
  titulo        String?
  descripcion   String?
  updatedAt     DateTime @updatedAt

  tienda        Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@unique([tiendaId, productId])
}

model OrdenTienda {
  id              String    @id @default(cuid())
  numero          Int       @default(autoincrement())
  token           String    @unique @default(cuid()) // link público de seguimiento
  tiendaId        String
  estado          String    @default("pendiente_pago") // pendiente_pago | pagada | enviada_nadin | lista | entregada | cancelada
  metodoPagoTipo  String
  metodoPagoNombre String
  envioTipo       String
  envioNombre     String
  envioCosto      Float     @default(0)
  subtotal        Float
  descuento       Float     @default(0)
  descuentoPromo  Float     @default(0) // promociones automáticas (2x1, 3x2, % off)
  promosTexto     String?
  cuponCodigo     String?
  total           Float
  totalMayorista  Float
  clienteNombre   String
  clienteEmail    String?
  clienteTelefono String
  clienteDni      String?
  direccion       Json?
  nota            String?
  mpPreferenceId  String?
  mpPaymentId     String?
  pedidoId        String?   @unique // Pedido creado en el flujo de Nadin
  pagadaAt        DateTime?
  enviadaNadinAt  DateTime?
  canceladaAt     DateTime?
  arrepentimiento Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tienda          Tienda    @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  items           OrdenTiendaItem[]

  @@index([tiendaId, createdAt])
  @@index([estado])
}

model OrdenTiendaItem {
  id         String  @id @default(cuid())
  ordenId    String
  productId  String
  variantId  String
  sku        String?
  brand      String?
  nombre     String
  talle      String?
  color      String?
  imagen     String?
  qty        Int
  precio     Float   // precio unitario cobrado a la clienta
  mayorista  Float   // costo unitario Nadin
  propio     Boolean @default(false) // producto cargado por la revendedora (no lo arma Nadin)
  qtyPropio  Int     @default(0)     // unidades que salen del stock propio de la revendedora (no van a Nadin)
  stockExtraId String?               // TiendaStockExtra de donde salen esas unidades

  orden      OrdenTienda @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  @@index([ordenId])
}

// Productos que la revendedora vende por su cuenta (no son de Nadin)
model TiendaProductoPropio {
  id          String   @id @default(cuid())
  tiendaId    String
  nombre      String
  descripcion String?
  categoria   String   @default("Otros")   // "Accesorios > Mochilas"
  imagenes    Json     @default("[]")      // string[]
  activo      Boolean  @default(true)
  destacado   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tienda      Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)
  variantes   TiendaVariantePropia[]

  @@index([tiendaId])
}

model TiendaVariantePropia {
  id          String  @id @default(cuid())
  productoId  String
  talle       String  @default("")  // opción 1 (talle, tamaño, modelo…)
  color       String  @default("")  // opción 2
  precio      Float
  precioAntes Float?  // precio tachado (oferta)
  stock       Int     @default(0)
  sku         String?

  producto    TiendaProductoPropio @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([productoId])
}

// Stock propio de la revendedora sobre productos de Nadin: suma stock a un
// talle/color que ya existe o agrega uno nuevo. Al vender se consume primero este stock.
model TiendaStockExtra {
  id         String   @id @default(cuid())
  tiendaId   String
  productId  String   // producto de Nadin (Tiendanube)
  clave      String   // talle|color normalizado (para no duplicar)
  talle      String   @default("")
  color      String   @default("")
  stock      Int      @default(0)
  precio     Float?   // solo para talles/colores nuevos; null = precio del producto
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tienda     Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@unique([tiendaId, productId, clave])
  @@index([tiendaId])
}

// Páginas propias de la tienda (Cómo comprar, Cambios, Envíos…)
model TiendaPagina {
  id        String   @id @default(cuid())
  tiendaId  String
  slug      String
  titulo    String
  contenido String   @default("")
  visible   Boolean  @default(true)
  enPie     Boolean  @default(true)  // link en el pie de página
  orden     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tienda    Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@unique([tiendaId, slug])
}

// Contactos que deja la gente (pop-up de bienvenida, etc.)
model TiendaContacto {
  id        String   @id @default(cuid())
  tiendaId  String
  nombre    String?
  email     String?
  telefono  String?
  origen    String   @default("popup")
  createdAt DateTime @default(now())

  tienda    Tienda   @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@index([tiendaId, createdAt])
}

// Estadísticas por día
model TiendaStatDia {
  id             String   @id @default(cuid())
  tiendaId       String
  fecha          DateTime @db.Date
  visitas        Int      @default(0)
  vistasProducto Int      @default(0)
  carritos       Int      @default(0)

  @@unique([tiendaId, fecha])
}

model TiendaStatProducto {
  id        String   @id @default(cuid())
  tiendaId  String
  productId String
  fecha     DateTime @db.Date
  vistas    Int      @default(0)

  @@unique([tiendaId, productId, fecha])
  @@index([tiendaId, fecha])
}

// Promociones automáticas: lleva N paga M, o % de descuento
model TiendaPromocion {
  id         String    @id @default(cuid())
  tiendaId   String
  nombre     String
  tipo       String    // nxm | porcentaje
  lleva      Int       @default(3)
  paga       Int       @default(2)
  porcentaje Float     @default(0)
  alcance    String    @default("todo") // todo | categoria | productos
  categoria  String?   // path de slugs: "mujer/corpinos"
  productos  Json      @default("[]")
  activa     Boolean   @default(true)
  desde      DateTime?
  hasta      DateTime?
  createdAt  DateTime  @default(now())

  tienda     Tienda    @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@index([tiendaId])
}

// Carritos que llegaron a dejar sus datos pero no compraron
model TiendaCarrito {
  id         String    @id @default(cuid())
  tiendaId   String
  token      String    @unique
  nombre     String?
  email      String?
  telefono   String?
  items      Json      @default("[]")
  total      Float     @default(0)
  estado     String    @default("abierto") // abierto | avisado | recuperado
  avisadoAt  DateTime?
  ordenId    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tienda     Tienda    @relation(fields: [tiendaId], references: [id], onDelete: Cascade)

  @@index([tiendaId, updatedAt])
}
